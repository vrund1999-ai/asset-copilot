# Copy to .env and fill in
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Fixed "today" for synthetic data and the agent (keeps eval gold answers reproducible)
AS_OF_DATE=2026-06-30

# App DB (admin: used only for schema + data loading)
DATABASE_URL_ADMIN=postgresql+psycopg://postgres:postgres@localhost:5432/asset_copilot
# Read-only role used by the agent's SQL tool
DATABASE_URL_READONLY=postgresql+psycopg://agent_ro:agent_ro@localhost:5432/asset_copilot

API_URL=http://localhost:8000
